<%- include('partials/header', { pageTitle: pageTitle, activePage: activePage }) %>
<!DOCTYPE html>
<html>
<head>
    <title><%= pageTitle %> | <%= siteTitle %></title>
    <link rel="stylesheet" href="/style.css"> 
</head>
<body>
    <div class="container">
        <h1><%= pageTitle %> ➕</h1>
        <p>Use the form below to add a new task and assign it to a list.</p>

        <form action="/add" method="POST" class="mt-8 space-y-4 p-6 bg-gray-50 rounded-lg shadow-inner">
            <div>
                <label for="entry" class="block text-sm font-medium text-gray-700 mb-1">Task Description:</label>
                <input type="text" id="entry" name="entry" required 
                        class="w-full p-2 border border-gray-300 rounded focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500">
            </div>

            <div>
                <label for="list-select" class="block text-sm font-medium text-gray-700 mb-1">Assign to List:</label>
                <select id="list-select" name="list" 
                        class="w-full p-2 border border-gray-300 rounded focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500">
                    
                    <option value="LIST A (House Chores)">LIST A (House Chores)</option>
                    <option value="LIST B (Yard & Pets)">LIST B (Yard & Pets)</option>
                    
                    <option value="new-list">-- Create New List --</option>
                </select>
            </div>

            <button type="submit" class="w-full py-2 px-4 bg-pink-500 text-white font-bold rounded hover:bg-pink-600 transition duration-150">
                Add Task
            </button>
        </form>
    </div>
</body>
</html>
<%- include('partials/footer') %>